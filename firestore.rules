rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /sermons/{sermonId} {
      // All visitors and admin can read sermons and series
      allow read: if true;

      // Only authenticated admin can create or delete sermons
      allow create, delete: if request.auth != null;

      // Admin can update all fields; visitors can only increment views/downloads stats
      allow update: if request.auth != null || 
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloadsCount', 'viewsCount']));
    }

    // تطبيقاتنا: يقرؤها الجميع، ولا يكتب فيها إلا مسؤول المنبر (Admin)
    match /apps/{appId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.token.email == 'cafnews6@gmail.com';
    }

    // Accounts & points per signed-in user (only the owner can read/write)
    // Owners may delete their own account data (required by Google Play policy)
    match /users/{userId} {
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;

      match /transactions/{transactionId} {
        allow read, create: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
        allow update: if false;
      }
    }

    // إعدادات مزوّد الذكاء الاصطناعي لكل مستخدم (المالك وحده)
    match /userSettings/{userId} {
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // الإعداد العام/المفتاح المشترك الذي تحدده الإدارة
    // يقرؤه المصادقون (لأنه يُستخدم افتراضياً لمن لا مفتاح خاص له)، ولا يكتبه إلا المسؤول
    match /adminSettings/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null
        && request.auth.token.email == 'cafnews6@gmail.com';
    }

    // المزوّدات المفتوحة للاستخدام العام: يقرؤها أي مصادق، ولا يعرضها إلا صاحبها
    match /sharedProviders/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
    }

    // مكافآت المزوّد المشترك: يُسجّل كل مستخدم استخدامه لمزوّد عام صالح (نقطة لصاحبه)،
    // ولا يقرؤها إلا صاحب المزوّد لتسلمها في حسابه
    match /providerRewards/{rewardId} {
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.ownerUid != request.auth.uid
        && request.resource.data.amount == 1
        && exists(/databases/$(database)/documents/sharedProviders/$(request.resource.data.providerDocId))
        && get(/databases/$(database)/documents/sharedProviders/$(request.resource.data.providerDocId)).data.ownerUid == request.resource.data.ownerUid
        && get(/databases/$(database)/documents/sharedProviders/$(request.resource.data.providerDocId)).data.active == true;
      allow read, update, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
  }
}

